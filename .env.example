OJ_DATABASE_PATH=./data/oj.sqlite3
OJ_RUNTIME_DIR=./runtime
# These executable overrides apply to the local backend. Newjudge uses the
# installed Linux toolchains in app/studio/toolchains.py, including OpenJDK 21.
OJ_C_COMPILER=gcc
OJ_CPP_COMPILER=g++
OJ_PYPY=pypy3
OJ_JAVAC=javac
OJ_JAVA=java
OJ_PYTHON=python3
OJ_JUDGE_MODE=newjudge
OJ_AUTH_REQUIRED=true
OJ_ADMIN_USERNAME=admin
# Required for a fresh database with authentication enabled. Set a unique value
# in /etc/sakura.env or the process environment, not in this example file.
OJ_ADMIN_PASSWORD=
OJ_SESSION_COOKIE=sakura_session
OJ_SESSION_TTL_SECONDS=604800
OJ_DOCKER_CLI=docker
OJ_DOCKER_IMAGE=sakura-oj-judge:local
OJ_DOCKER_GRACE_MS=5000
OJ_MAX_SOURCE_BYTES=100000
OJ_MAX_OUTPUT_BYTES=1048576
OJ_COMPILE_TIMEOUT_MS=10000

# WSL/Linux service loads /etc/sakura.env; this file is only a reference.
SAKURA_JUDGE_RUNTIME=/opt/sakura/runtime
SAKURA_JUDGE_WORK=/var/lib/sakura/judge
# Default locations follow the parent directory of OJ_DATABASE_PATH:
# SAKURA_STUDIO_DATA=./data/studio
# SAKURA_DATABASE_PATH=./data/team.sqlite3
SAKURA_SEED_DEMO=false
# Optional external data providers; local OJ linkage needs no URL.
# NowCoder uses official public APIs by UID by default. Optional override accepts ?uid=...
# SAKURA_NOWCODER_API_URL=
# SAKURA_OJ_BASE_URL=
SAKURA_REQUEST_TIMEOUT=8
